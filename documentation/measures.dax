// =====================================================================
// Remote Work & Employee Wellbeing: DAX measures
// Table: remote_work_cleaned  (from data/cleaned_remote_work_wellbeing.csv)
// All measures describe the dataset as observed. None is a diagnosis or a cause.
// Expected values after loading (verify in the dashboard):
//   Total Employees 5,000 | Remote Share 34.3% | Satisfied Share 33.5%
//   High Stress Share 33.7% | Poor Sleep Share 33.7% | Access to Resources 48.9%
//   Avg Hours per Week 39.61 | Avg Work-Life Balance 2.98 | Avg Satisfaction Score 2.00
//   Productivity Increase 31.7% | Mental Condition Reported 76.1%
// =====================================================================

Total Employees =
COUNTROWS ( remote_work_cleaned )

Remote Share % =
DIVIDE ( CALCULATE ( [Total Employees], remote_work_cleaned[Work_Location] = "Remote" ), [Total Employees] )

Satisfied Share % =
DIVIDE ( CALCULATE ( [Total Employees], remote_work_cleaned[Satisfaction_with_Remote_Work] = "Satisfied" ), [Total Employees] )

High Stress Share % =
DIVIDE ( CALCULATE ( [Total Employees], remote_work_cleaned[Stress_Level] = "High" ), [Total Employees] )

Poor Sleep Share % =
DIVIDE ( CALCULATE ( [Total Employees], remote_work_cleaned[Sleep_Quality] = "Poor" ), [Total Employees] )

Access to Resources % =
DIVIDE ( CALCULATE ( [Total Employees], remote_work_cleaned[Access_to_Mental_Health_Resources] = "Yes" ), [Total Employees] )

Productivity Increase % =
DIVIDE ( CALCULATE ( [Total Employees], remote_work_cleaned[Productivity_Change] = "Increase" ), [Total Employees] )

Mental Condition Reported % =
DIVIDE ( CALCULATE ( [Total Employees], remote_work_cleaned[Mental_Health_Condition] <> "Not reported" ), [Total Employees] )

Avg Hours per Week =
AVERAGE ( remote_work_cleaned[Hours_Worked_Per_Week] )

Avg Work-Life Balance (1-5) =
AVERAGE ( remote_work_cleaned[Work_Life_Balance_Rating] )

Avg Satisfaction Score (1-3) =
AVERAGE ( remote_work_cleaned[Satisfaction_Score] )
